{
  "name": "finguard-ai",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "next lint",
    "test": "tsx tests/phase4.test.ts && tsx tests/agents.test.ts && tsx tests/guardrails.test.ts",
    "test:phase4": "tsx tests/phase4.test.ts",
    "test:bot-source": "tsx -e \"import { discoverBotAnnouncements } from './src/lib/agents/ingestion/sources/bot/bot-source-adapter'; discoverBotAnnouncements(3).then(r => console.log('BOT Discovery Result:', JSON.stringify(r, null, 2)));\"",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma db push && tsx prisma/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^1.1.20",
    "@ai-sdk/openai": "^1.1.15",
    "@prisma/client": "^6.4.1",
    "ai": "^4.1.45",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.5.0",
    "lucide-react": "^0.475.0",
    "next": "^15.1.7",
    "next-auth": "5.0.0-beta.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.21.0",
    "eslint-config-next": "^15.1.7",
    "postcss": "^8.5.3",
    "prisma": "^6.4.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
