# =========================================================
# FINGUARD AI - ENVIRONMENT CONFIGURATION (NEON POSTGRESQL)
# =========================================================

# Database: PostgreSQL with pgvector extension
# 1. For Neon Serverless PostgreSQL (Recommended):
# - Pooled connection string (for queries, with -pooler and ?sslmode=require):
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-YOUR-PROJECT-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# - Direct connection string (for Prisma migrations and schema push):
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-YOUR-PROJECT.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# 2. Local Docker / Standalone PostgreSQL Fallback:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finguard_db?schema=public"

# NextAuth v5 Configuration
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="finguard_super_secret_jwt_key_compliance_2026_min_32_chars!"

# AI Model Inference (Vercel AI SDK compatible)
# Gemini API Key (recommended for Google AI SDK)
GOOGLE_GENERATIVE_AI_API_KEY="your-google-ai-api-key-here"
# OpenAI API Key (optional alternative)
OPENAI_API_KEY="your-openai-api-key-here"

# Security & PDPA Settings
ENABLE_PII_AUTO_MASKING="true"
AUDIT_INTEGRITY_SALT="finguard-ledger-salt-compliance-2026"
