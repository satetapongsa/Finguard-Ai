# =========================================================
# FINGUARD AI - ENVIRONMENT CONFIGURATION TEMPLATE
# =========================================================

# Database: PostgreSQL with pgvector extension (Neon Serverless PostgreSQL recommended)
DATABASE_URL="postgresql://user:password@ep-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-direct.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# NextAuth Authentication Secret (min 32 characters)
AUTH_SECRET="finguard_super_secret_jwt_key_compliance_2026_min_32_chars!"
NEXTAUTH_URL="http://localhost:3000"

# Operational Modes & Toggles
# REGULATORY_SOURCE_MODE: "demo" (deterministic synthetic fixture) | "bot" (official Bank of Thailand live fetch)
REGULATORY_SOURCE_MODE="demo"

# AI_MODE: "deterministic" (zero-hallucination rule reasoning) | "live" (LLM reasoning)
AI_MODE="deterministic"

# EMBEDDING_MODE: "none" (deterministic fallback) | "live" (OpenAI / pgvector embeddings)
EMBEDDING_MODE="none"

# AI Provider Configuration (Optional for Live Mode)
AI_PROVIDER="deepseek"
AI_BASE_URL="https://api.deepseek.com"
AI_MODEL="deepseek-chat"
AI_API_KEY=""

# Vector Embedding Configuration (Optional for Live Mode)
EMBEDDING_PROVIDER="none"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_API_KEY=""

# Scheduled Watcher Cron Secret (Server-side secret for /api/watcher/cron)
CRON_SECRET="finguard-cron-internal-key-2026"
WATCHER_SECRET="finguard-cron-internal-key-2026"

# Security & Compliance Settings
ENABLE_PII_AUTO_MASKING="true"
AUDIT_INTEGRITY_SALT="finguard-ledger-salt-compliance-2026"
